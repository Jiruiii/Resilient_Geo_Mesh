{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resilientgeo.mesh/schemas/manifest-v0.schema.json",
  "title": "ResilientGeo Mesh Manifest v0",
  "description": "A signed index of the chunks that make up one dataset version.",
  "$comment": "The manifest hash is calculated from the canonical manifest with manifest_hash and signature fields omitted. A receiver must verify the manifest before trusting chunk metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "dataset_id",
    "namespace",
    "source",
    "source_version",
    "dataset_version",
    "created_at",
    "expires_at",
    "chunking",
    "total_event_count",
    "total_size_bytes",
    "chunks",
    "manifest_hash",
    "signature",
    "signature_algorithm",
    "signing_key_id"
  ],
  "properties": {
    "schema_version": {
      "const": "manifest-v0"
    },
    "manifest_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,255}$"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,31}$"
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "source_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "dataset_version": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "chunking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "target_size_bytes",
        "hash_algorithm"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": [
            "fixed-size",
            "content-defined"
          ]
        },
        "target_size_bytes": {
          "type": "integer",
          "minimum": 256,
          "maximum": 10485760
        },
        "hash_algorithm": {
          "const": "SHA-256"
        }
      }
    },
    "total_event_count": {
      "type": "integer",
      "minimum": 0
    },
    "total_size_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "chunks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/chunk"
      }
    },
    "previous_manifest_hash": {
      "$ref": "#/$defs/sha256"
    },
    "manifest_hash": {
      "$ref": "#/$defs/sha256"
    },
    "signature": {
      "type": "string",
      "minLength": 4,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "signature_algorithm": {
      "const": "Ed25519"
    },
    "signing_key_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[A-Fa-f0-9]{64}$"
    },
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number"
      }
    },
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chunk_id",
        "sequence",
        "chunk_hash",
        "size_bytes",
        "event_count",
        "priority",
        "area_id",
        "theme",
        "bbox",
        "event_ids"
      ],
      "properties": {
        "chunk_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[a-z0-9][a-z0-9._:-]{0,255}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "area_id": {
          "type": "string",
          "description": "Geographic slice this chunk belongs to. Lets a node decide whether the chunk intersects its area without downloading it.",
          "pattern": "^[a-z][a-z0-9._-]{0,63}$"
        },
        "category_code": {
          "type": "string",
          "description": "Optional signed alert-category routing key; currently emitted for NCDR chunks.",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "theme": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,31}$"
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        },
        "chunk_hash": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "event_count": {
          "type": "integer",
          "minimum": 1
        },
        "priority": {
          "type": "string",
          "enum": [
            "CRITICAL",
            "HIGH",
            "NORMAL",
            "LOW"
          ]
        },
        "event_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    }
  }
}
