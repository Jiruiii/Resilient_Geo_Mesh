{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resilientgeo.mesh/schemas/event-v0.schema.json",
  "title": "ResilientGeo Mesh Event v0",
  "description": "A signed, spatial event that can be stored and relayed by a peer.",
  "$comment": "The logical identity of an event is (namespace, event_id). A receiver must verify payload_hash and signature before applying an event. expires_at is evaluated against the receiver clock and is not a replacement for retaining the cached record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "namespace",
    "event_id",
    "event_type",
    "geometry",
    "severity",
    "source",
    "source_version",
    "event_version",
    "issued_at",
    "expires_at",
    "attributes",
    "payload_hash",
    "signature",
    "signature_algorithm",
    "signing_key_id",
    "provenance"
  ],
  "allOf": [
    {
      "$comment": "Self-certifying device keys are limited to crowd.*. official.announcement may use a device key only with a centrally signed government device certificate.",
      "if": {
        "required": ["signing_key_id"],
        "properties": {
          "signing_key_id": {
            "pattern": "^device:"
          }
        }
      },
      "then": {
        "required": ["signer_public_key"],
        "properties": {
          "namespace": {
            "pattern": "^(crowd\\.|official\\.announcement$)"
          },
          "attributes": {
            "properties": {
              "government_device_certificate": {
                "$ref": "#/$defs/governmentDeviceCertificate"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "namespace": { "const": "official.announcement" }
              }
            },
            "then": {
              "properties": {
                "attributes": {
                  "required": ["government_device_certificate"]
                }
              }
            }
          }
        ]
      }
    }
  ],
  "properties": {
    "schema_version": {
      "const": "event-v0"
    },
    "namespace": {
      "type": "string",
      "description": "Isolation boundary for versioning and trust; official and crowd namespaces never overwrite one another.",
      "pattern": "^[a-z][a-z0-9._-]{0,31}$"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,255}$"
    },
    "event_type": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "geometry": {
      "oneOf": [
        {
          "$ref": "#/$defs/point"
        },
        {
          "$ref": "#/$defs/lineString"
        },
        {
          "$ref": "#/$defs/polygon"
        },
        {
          "$ref": "#/$defs/multiPoint"
        },
        {
          "$ref": "#/$defs/multiLineString"
        },
        {
          "$ref": "#/$defs/multiPolygon"
        },
        {
          "$ref": "#/$defs/geometryCollection"
        }
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL",
        "UNKNOWN"
      ]
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "source_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "event_version": {
      "type": "integer",
      "minimum": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "attributes": {
      "type": "object",
      "description": "Source-specific data. It is included in the signed canonical payload.",
      "additionalProperties": true,
      "properties": {
        "government_device_certificate": {
          "$ref": "#/$defs/governmentDeviceCertificate"
        }
      }
    },
    "payload_hash": {
      "$ref": "#/$defs/sha256"
    },
    "signature": {
      "type": "string",
      "description": "Base64-encoded Ed25519 signature over the canonical payload and payload_hash.",
      "minLength": 4,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "signature_algorithm": {
      "const": "Ed25519"
    },
    "signing_key_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "signer_public_key": {
      "type": "string",
      "description": "Base64 SPKI DER Ed25519 public key of a device-signed event. Required when signing_key_id starts with device:, where signing_key_id must equal device: plus the first 32 hex characters of sha256(SPKI DER).",
      "minLength": 4,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original_source",
        "received_at",
        "transport_source"
      ],
      "properties": {
        "original_source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "received_at": {
          "type": "string",
          "format": "date-time"
        },
        "transport_source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "upstream",
                "server",
                "peer",
                "local_fixture",
                "local_report"
              ]
            },
            "node_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[A-Fa-f0-9]{64}$"
    },
    "coordinate": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "const": "Point"
        },
        "coordinates": {
          "$ref": "#/$defs/coordinate"
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        }
      }
    },
    "lineString": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "const": "LineString"
        },
        "coordinates": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/coordinate"
          }
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        }
      }
    },
    "polygon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "const": "Polygon"
        },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 4,
            "items": {
              "$ref": "#/$defs/coordinate"
            }
          }
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        }
      }
    },
    "multiPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "const": "MultiPoint"
        },
        "coordinates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/coordinate"
          }
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        }
      }
    },
    "multiLineString": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "const": "MultiLineString"
        },
        "coordinates": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 2,
            "items": {
              "$ref": "#/$defs/coordinate"
            }
          }
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        }
      }
    },
    "multiPolygon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "coordinates"
      ],
      "properties": {
        "type": {
          "const": "MultiPolygon"
        },
        "coordinates": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 4,
              "items": {
                "$ref": "#/$defs/coordinate"
              }
            }
          }
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        }
      }
    },
    "geometryCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "geometries"
      ],
      "properties": {
        "type": {
          "const": "GeometryCollection"
        },
        "geometries": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/point"
              },
              {
                "$ref": "#/$defs/lineString"
              },
              {
                "$ref": "#/$defs/polygon"
              },
              {
                "$ref": "#/$defs/multiPoint"
              },
              {
                "$ref": "#/$defs/multiLineString"
              },
              {
                "$ref": "#/$defs/multiPolygon"
              }
            ]
          }
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        }
      }
    },
    "bbox": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "number"
      }
    },
    "governmentDeviceCertificate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "certificate_id", "device_id", "subject_id",
        "signing_key_id", "signer_public_key", "agency", "permissions",
        "issued_at", "expires_at", "issuer_key_id", "signature_algorithm", "signature"
      ],
      "properties": {
        "schema_version": { "const": "government-device-certificate-v1" },
        "certificate_id": { "type": "string", "pattern": "^gov-cert:[a-z0-9-]{1,128}$" },
        "device_id": { "type": "string", "pattern": "^gov-device:[a-z0-9-]{1,128}$" },
        "subject_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "signing_key_id": { "type": "string", "pattern": "^device:[0-9a-f]{32}$" },
        "signer_public_key": { "type": "string", "minLength": 4, "pattern": "^[A-Za-z0-9+/]+={0,2}$" },
        "agency": { "type": "string", "minLength": 1, "maxLength": 160 },
        "permissions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "const": "official.announcement.publish" }
        },
        "issued_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "issuer_key_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "signature_algorithm": { "const": "Ed25519" },
        "signature": { "type": "string", "minLength": 4, "pattern": "^[A-Za-z0-9+/]+={0,2}$" }
      }
    }
  }
}
