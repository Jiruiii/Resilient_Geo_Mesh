{$SERVER_DOMAIN} {
    encode gzip zstd

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
    }

    @public path /healthz /readyz /feed.json /releases/* /v1/*
    handle @public {
        reverse_proxy api:8787
    }

    @address_catalog path /address-packs/catalog.json
    handle @address_catalog {
        root * /srv/address-packs
        uri strip_prefix /address-packs
        header Cache-Control "no-cache"
        file_server
    }

    handle_path /address-packs/* {
        root * /srv/address-packs
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }

    handle {
        root * /srv/web
        try_files {path} /index.html
        file_server
    }
}
