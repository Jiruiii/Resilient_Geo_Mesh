# TDX HTTP API credentials. Fill the local .env, not this file.
TDX_CLIENT_ID=
TDX_CLIENT_SECRET=

# TDX Road Events API endpoints.
TDX_API_ENDPOINT=https://tdx.transportdata.tw/api/basic/v1/Traffic/RoadEvent/LiveEvent/City/Taipei?$format=JSON
# Comma-separated nationwide endpoints. Leave blank to use the built-in Taiwan list
# when --scope taiwan is supplied.
TDX_API_ENDPOINTS=
TDX_TOKEN_ENDPOINT=https://tdx.transportdata.tw/auth/realms/TDXConnect/protocol/openid-connect/token
# Used when a live event has no source ExpireTime/EndTime and the response has
# no UpdateInterval. Override only after reviewing the source freshness policy.
TDX_EVENT_FRESHNESS_SECONDS=900
# Delay between sequential Taiwan endpoint requests to reduce burst rate limiting.
TDX_ENDPOINT_DELAY_MS=1000
# CWA Open Data API. The key is sent only to the configured CWA endpoint.
CWA_API_KEY=
CWA_EARTHQUAKE_ENDPOINT=https://opendata.cwa.gov.tw/api/v1/rest/datastore/E-A0015-001
CWA_WARNING_ENDPOINT=https://opendata.cwa.gov.tw/api/v1/rest/datastore/W-C0033-001
CWA_TYPHOON_ENDPOINT=https://opendata.cwa.gov.tw/api/v1/rest/datastore/W-C0034-001

# NCDR official alert API. The list route returns capid entries; the detail
# route returns the complete CAP document for each capid.
NCDR_ALERT_API_KEY=
NCDR_ALERT_API_BASE_URL=https://alerts.ncdr.nat.gov.tw
NCDR_ALERT_ENDPOINT=https://alerts.ncdr.nat.gov.tw/api/datastore
NCDR_ALERT_DETAIL_ENDPOINT=https://alerts.ncdr.nat.gov.tw/api/dump/datastore
# The official /api routes use apikey=... in the query string.
NCDR_AUTH_MODE=query

NCDR_DETAIL_CONCURRENCY=4
# Legacy names are accepted for existing local environments.
NCDR_API_KEY=
NCDR_API_ENDPOINT=

# Static source endpoints. These are public defaults and can be overridden for
# a mirror or a reviewed snapshot service. The medical endpoint is the current
# MOHW ODS resource linked by data.gov.tw dataset 15393; update the URL when
# the annual MOHW file changes.
OSM_API_ENDPOINT=https://overpass-api.de/api/interpreter
OSM_TIMEOUT_MS=120000
SHELTER_DATA_ENDPOINT=https://opdadm.moi.gov.tw/api/v1/no-auth/resource/api/dataset/ED6CF735-6C03-4573-A882-72C1BEC799CB/resource/54550E2F-4567-4C8F-BD2E-E54E9D0386B8/download
MEDICAL_DATA_ENDPOINT=https://www.mohw.gov.tw/dl-96581-66dbb751-f83a-416a-a998-893222e20fef.html
MEDICAL_DATA_FORMAT=ods
MEDICAL_COORDINATE_ENDPOINT=https://api.nlsc.gov.tw/other/MarkBufferAnlys/med
MEDICAL_COORDINATE_FALLBACK_ENDPOINTS=
MEDICAL_COORDINATE_RADIUS_METERS=25000
MEDICAL_COORDINATE_SPACING_METERS=30000
MEDICAL_COORDINATE_MAX_QUERIES=500
MEDICAL_COORDINATE_CONCURRENCY=4
MEDICAL_COORDINATE_TIMEOUT_MS=120000

# Full Taiwan mode. Generate the catalog with `area-catalog` before collection.
DATA_SCOPE=taiwan
TAIWAN_BOUNDARY_PATH=/absolute/path/to/data/area-catalog.json
AREA_CATALOG_PATH=

# Keep the private signing key outside the app and outside Git.
PIPELINE_SIGNING_PRIVATE_KEY=

# The production publisher is server/src/collector-entrypoint.mjs. Keep
# signing paths and credentials in the server .env/secret store, not here.
