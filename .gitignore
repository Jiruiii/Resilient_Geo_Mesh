# Local key material and generated bundles.
.stage2-keys/
.government-public/
.stage2-bundle/
.neihu-bundle/
.neihu-scale/
.sim-out/
.sim-out*/

# Downloaded live snapshots and future analytics outputs. Keep deterministic
# demo fixtures under data/fixtures/ versioned and reviewable.
/data/live/
/data/derived/

# Generated nationwide administrative-area catalog. Recreate locally from
# data/boundaries/geojson with `node pipeline/cli.mjs area-catalog`.
/data/area-catalog.json

# Local API credentials. Never commit real values.
.env
.env.*
!.env.example

# Installed JavaScript dependencies.
node_modules/

# Python test/runtime artifacts.
__pycache__/
*.py[cod]

# Android
/android/.gradle/
/android/.kotlin/
/android/.idea/
# Android Studio also writes an .idea/ next to the module when the
# project is opened at android/app/ rather than android/. Without
# this line android/app/.idea/workspace.xml ended up tracked and the
# rest of that directory sat permanently untracked in git status.
/android/app/.idea/
# Android Studio may also create a workspace when the repository root is opened.
/.idea/
# Playwright CLI snapshots are local verification artifacts.
/.playwright-cli/
/android/local.properties
/android/build/
/android/*/build/
/android/*/*/build/
*.iml
.DS_Store

# Local scratch notes, not shared with the team.
/docs/jia-task-sequence.md
/.superpowers/

# OSM/PMTiles/search build inputs and intermediate files. Versioned app assets under
# flutter/assets/map/ remain visible and are intentionally not ignored.
/tools/maps/.cache/
/tools/maps/.work/
/tools/maps/*.osm.pbf
/tools/maps/*.osc.gz
/tools/maps/*.zip

# The Taiwan styles currently reference only NotoSansRegular. Keep the
# downloaded fallback font families local without adding their glyph shards.
/flutter/assets/map/fonts/Noto Sans Medium/
/flutter/assets/map/fonts/Noto Sans Italic/
/flutter/assets/map/fonts/Noto Sans Devanagari Regular v1/

# Only the light and dark sprite sets are referenced by the Taiwan styles.
/flutter/assets/map/sprites/v4/black*
/flutter/assets/map/sprites/v4/grayscale*
/flutter/assets/map/sprites/v4/white*

未來際

output
